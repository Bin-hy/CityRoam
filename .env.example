# TripPilot 环境变量模板
#
# 用法：
#   本地开发：复制为根目录 .env.local，再用 `set -a; . ./.env.local; set +a` 导出
#   Compose：复制为 deploy/.env（Compose 只会读取 deploy 目录下的 .env）
#   前端开发：VITE_* 变量放在 web/.env.local，或先 export 再 npm run dev
#
# 本文件只写占位值，不要填入真实密钥后提交；除本模板外，.env / .env.* / *.local 均被 gitignore。

# ==================== 数据库与服务 ====================

# 必填。Postgres DSN；启动时自动执行 goose 迁移，无需单独 migrate。
DATABASE_URL=postgres://trippilot:trippilot@localhost:5432/trippilot?sslmode=disable

# 监听端口，1-65535，默认 8080。
PORT=8080

# 日志级别：debug | info | warn | error，默认 info。
LOG_LEVEL=info

# 仅供容器健康检查程序使用（本地开发不用配）。
# 默认 http://127.0.0.1:8080/healthz；改 PORT 时容器内一般无需改。
# HEALTHCHECK_URL=http://127.0.0.1:8080/healthz

# ==================== LLM（OpenAI 兼容接口） ====================

# 必填。Base URL，客户端会自动追加 /chat/completions；
# 若服务要求 /v1 前缀，写成 https://host/v1。
LLM_BASE_URL=https://api.deepseek.com

# 实际必填。允许为空启动，但所有 LLM 调用会 401，run 以 failed 结束。
LLM_API_KEY=

# 必填。必须是 provider 支持的模型名；写错会在首次调用时报 4xx。
LLM_MODEL=deepseek-chat

# ==================== 高德地图 ====================

# 后端「Web 服务」类型 key。为空时：无实时 POI、路程回退直线距离、天气工具不可用，主链仍可跑。
AMAP_WEB_KEY=

# 前端「Web 端 (JS API)」key，构建期打进 bundle；为空时地图卡片显示降级提示。
# 两类 key 不同，需分别在高德控制台申请并配置域名白名单。
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=

# ==================== 限流与管理 ====================

# 每 key 每小时的写请求额度，1-1000000。登录启用后按用户 ID 计数，否则按 IP。
# 只限制写接口（创建/删除/调整/replan/恢复/分享/resume/cancel），GET 与 SSE 不受限。
RATE_LIMIT_PER_HOUR=10

# 保护 /api/eval/*。为空时所有请求返回 401（不是免鉴权）；
# 请求头可用 X-Admin-Token: <token> 或 Authorization: Bearer <token>。
ADMIN_TOKEN=

# ==================== 用户登录（OIDC，默认关闭） ====================
# 关闭时保持匿名 demo 流程：无 Cookie 要求，列表返回无主行程，分享页公开。
# 开启后必须登录才能创建/查看行程；四个必填项任一缺失会启动失败。

AUTH_ENABLED=false

# 必填（开启时）。IdP issuer，必须是 http/https URL，用于 discovery。
OIDC_ISSUER=

# 必填（开启时）。在 IdP 注册的 Web 应用 client id / secret。
# OIDC_CLIENT_SECRET 只放服务端环境变量，不写库、不下发浏览器、不写日志。
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# 必填（开启时）。必须与 IdP 注册的回调地址完全一致。
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/callback

# 空格分隔，至少包含 openid。含空格的值必须加引号，否则 source 时会被拆成命令。
OIDC_SCOPES="openid profile email"

# 可选 token 混淆防护。非空时额外校验 access token 的 audience；
# 这里填 access token 的资源 audience（yufu 形如 urn:yufu:<project-id>:<env>:api），
# 不是 client id 或应用名，填错会让登录回调报 expected audience。
# 只用 ID token 做登录（本项目的 BFF 流程）时留空即可。
OIDC_AUDIENCE=

# 登录页展示的提供方名称。
OIDC_PROVIDER_NAME=统一登录

# IdP 支持 end-session 时，退出后的回跳地址。
OIDC_POST_LOGOUT_REDIRECT_URI=

# 同源部署留空；前后端分离时填 Web 源（如 https://web.example.com），回调后跳回该地址。
AUTH_WEB_BASE_URL=

# 服务端会话绝对有效期（Go duration）。
AUTH_SESSION_TTL=168h

# 会话 Cookie 的 Secure 策略：auto 在 TLS 或 X-Forwarded-Proto=https 时加 Secure。
# 可选 auto | true | false。
AUTH_COOKIE_SECURE=auto

# 管理员白名单，逗号分隔。邮箱要求 email_verified=true；sub 精确匹配。
# admin 仅能访问 /api/eval/*，不能查看其他用户行程。
ADMIN_EMAILS=
ADMIN_SUBS=

# 跨域白名单，逗号分隔的完整源（含 scheme），不允许 *。
# 仅前后端分离时需要；本地 Vite 代理模式若开启登录也需填 Web 源，
# 否则写请求会返回 403 请求来源不被允许。
# 例：http://localhost:5173
CORS_ALLOWED_ORIGINS=

# ==================== 研究插件与研究循环 ====================

# 插件总开关（酒店/攻略）默认关闭；开启后缺依赖只会禁用该插件，不影响启动。
HOTEL_PLUGIN_ENABLED=false
GUIDE_PLUGIN_ENABLED=false

# 研究阶段总时限与工具调用上限；超时后降级为短 brief，不阻断主链。
RESEARCH_TIMEOUT=12s
RESEARCH_MAX_TOOL_CALLS=6

# 天气工具没有独立开关：AMAP_WEB_KEY 非空即启用（get_weather），状态见 /api/meta 的 plugins.weather。
# 以下三项仅用于调优，默认 30m / 3s / 1。
WEATHER_CACHE_TTL=30m
WEATHER_TOOL_TIMEOUT=3s
WEATHER_MAX_CALLS_PER_RUN=1

# ==================== Agent Skills ====================
# 技能目录，默认 skills；目录不存在时按无技能启动。
# 结构：skills/<name>/<version>/SKILL.md，活动版本与内容哈希由 skills/skills.lock.json 固定。
# 修改已固定版本会因哈希不一致导致启动失败；升级请新增版本目录并显式改锁。
# 已在等待或恢复的 run 使用 runs.state 里的旧技能快照，不受升级影响。
SKILLS_DIR=skills

# ==================== 酒店插件（FlyAI sidecar） ====================

# 本地写 http://127.0.0.1:8090；Compose 内写 http://hotel-tool:8090（代码默认值）。
HOTEL_TOOL_URL=http://127.0.0.1:8090

# API 调 sidecar 的 Bearer token，sidecar 用同一变量校验；为空表示不鉴权，仅限本机/内网。
HOTEL_TOOL_TOKEN=

# 单次搜索超时与结果缓存时间。
HOTEL_SEARCH_TIMEOUT=10s
HOTEL_CACHE_TTL=30m

# 以下两项仅供酒店 sidecar 使用（API 不读取；本地 source 时一并导出不会影响 API）。
# FLYAI_API_KEY 为 FlyAI CLI 使用的 key；FLYAI_BIN 为 CLI 路径（Compose 内为 /app/node_modules/.bin/flyai）。
FLYAI_API_KEY=
FLYAI_BIN=flyai

# sidecar 自身的超时调优（毫秒），默认 9000 / 1500。
# FLYAI_TIMEOUT_MS=9000
# FLYAI_HEALTH_TIMEOUT_MS=1500

# ==================== 攻略插件（搜索摘要） ====================

# base 后固定拼接 /v1/tools/search，不要再重复带 /v1。
GUIDE_SEARCH_BASE_URL=https://api.deepseek.com

# 开启时必填；为空时插件被禁用，原因 GUIDE_SEARCH_API_KEY is empty。
GUIDE_SEARCH_API_KEY=

# 单次搜索超时与结果缓存时间。
GUIDE_SEARCH_TIMEOUT=10s
GUIDE_CACHE_TTL=6h

# ==================== 前端与本地开发 ====================
# 以下变量不属于 API 进程；不要与上面的服务端密钥混用。

# 前端构建期变量：写进 web/.env.local，或由 deploy/.env 作为 build args 传入。
# VITE_API_BASE 仅在 API 与前端不同源时设置，留空表示同源。
# VITE_API_BASE=

# Vite 开发服务器读取 Node 进程环境（无 VITE_ 前缀）。
# API_PROXY_TARGET 指定 /api 代理目标；WEB_PORT 指定开发端口。
# API_PROXY_TARGET=http://localhost:8080
# WEB_PORT=5173
